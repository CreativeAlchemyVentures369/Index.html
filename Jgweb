<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Creative Alchemy Ventures 369 | Real Estate & Business Funding</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Georgia', serif;
            line-height: 1.6;
            color: #2d3436;
            background: linear-gradient(135deg, #a8b8a8 0%, #c8a2c8 100%);
            min-height: 100vh;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            padding: 0 20px;
        }

        /* Header */
        header {
            background: rgba(255, 255, 255, 0.95);
            backdrop-filter: blur(10px);
            padding: 1rem 0;
            position: fixed;
            width: 100%;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 20px rgba(0,0,0,0.1);
            border-bottom: 2px solid #c0c0c0;
        }

        nav {
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            font-size: 1.8rem;
            font-weight: bold;
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-decoration: none;
            font-family: 'Georgia', serif;
        }

        .nav-links {
            display: flex;
            list-style: none;
            gap: 2rem;
        }

        .nav-links a {
            text-decoration: none;
            color: #2d3436;
            font-weight: 500;
            transition: color 0.3s ease;
            font-family: 'Georgia', serif;
        }

        .nav-links a:hover {
            color: #c0c0c0;
        }

        /* Hero Section */
        .hero {
            background: linear-gradient(135deg, rgba(168, 184, 168, 0.9), rgba(200, 162, 200, 0.9));
            color: #2d3436;
            padding: 120px 0 80px;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .hero::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><defs><pattern id="grain" width="100" height="100" patternUnits="userSpaceOnUse"><circle cx="20" cy="20" r="1" fill="white" opacity="0.1"/><circle cx="80" cy="80" r="1" fill="white" opacity="0.1"/><circle cx="40" cy="60" r="1" fill="white" opacity="0.1"/></pattern></defs><rect width="100" height="100" fill="url(%23grain)"/></svg>');
            opacity: 0.3;
        }

        .hero-content {
            position: relative;
            z-index: 2;
        }

        .hero h1 {
            font-size: 3.5rem;
            margin-bottom: 1rem;
            font-weight: 700;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
            color: #2d3436;
            font-family: 'Georgia', serif;
        }

        .hero p {
            font-size: 1.3rem;
            margin-bottom: 2rem;
            opacity: 0.9;
            color: #2d3436;
            font-family: 'Georgia', serif;
        }

        .cta-button {
            display: inline-block;
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            color: #2d3436;
            padding: 15px 30px;
            text-decoration: none;
            border-radius: 50px;
            font-weight: bold;
            font-size: 1.1rem;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
            font-family: 'Georgia', serif;
        }

        .cta-button:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
            background: linear-gradient(45deg, #a8a8a8, #c0c0c0);
        }

        /* Services Section */
        .services {
            padding: 80px 0;
            background: rgba(255, 255, 255, 0.95);
        }

        .section-title {
            text-align: center;
            font-size: 2.5rem;
            margin-bottom: 3rem;
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-family: 'Georgia', serif;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .service-card {
            background: linear-gradient(145deg, rgba(168, 184, 168, 0.1), rgba(200, 162, 200, 0.1));
            padding: 2rem;
            border-radius: 20px;
            text-align: center;
            transition: all 0.3s ease;
            border: 2px solid rgba(192, 192, 192, 0.3);
            backdrop-filter: blur(5px);
        }

        .service-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 20px 40px rgba(0,0,0,0.1);
            border-color: #c0c0c0;
            background: linear-gradient(145deg, rgba(168, 184, 168, 0.2), rgba(200, 162, 200, 0.2));
        }

        .service-icon {
            font-size: 3rem;
            margin-bottom: 1rem;
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .service-card h3 {
            font-size: 1.5rem;
            margin-bottom: 1rem;
            color: #c0c0c0;
            font-family: 'Georgia', serif;
            font-weight: bold;
        }

        .service-card p {
            color: #2d3436;
            font-family: 'Georgia', serif;
        }

        /* Pricing Section */
        .pricing {
            padding: 80px 0;
            background: linear-gradient(135deg, rgba(168, 184, 168, 0.1), rgba(200, 162, 200, 0.1));
        }

        .pricing-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }

        .pricing-card {
            background: rgba(255, 255, 255, 0.95);
            padding: 2rem;
            border-radius: 15px;
            text-align: center;
            box-shadow: 0 10px 30px rgba(0,0,0,0.1);
            transition: all 0.3s ease;
            border: 2px solid rgba(192, 192, 192, 0.3);
        }

        .pricing-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 40px rgba(0,0,0,0.15);
            border-color: #c0c0c0;
        }

        .pricing-card h3 {
            font-size: 1.3rem;
            margin-bottom: 0.5rem;
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-family: 'Georgia', serif;
            font-weight: bold;
        }

        .pricing-card .price {
            font-size: 1.1rem;
            color: #2d3436;
            margin-bottom: 1rem;
            font-family: 'Georgia', serif;
            font-weight: 600;
        }

        /* Contact Section */
        .contact {
            padding: 80px 0;
            background: linear-gradient(135deg, rgba(168, 184, 168, 0.9), rgba(200, 162, 200, 0.9));
            color: #2d3436;
            text-align: center;
        }

        .contact .section-title {
            color: #2d3436;
            background: none;
            -webkit-background-clip: unset;
            -webkit-text-fill-color: unset;
        }

        .contact-form {
            max-width: 600px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.9);
            padding: 2rem;
            border-radius: 20px;
            backdrop-filter: blur(10px);
            border: 2px solid rgba(192, 192, 192, 0.3);
        }

        .form-group {
            margin-bottom: 1.5rem;
            text-align: left;
        }

        .form-group label {
            display: block;
            margin-bottom: 0.5rem;
            font-weight: 600;
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-family: 'Georgia', serif;
        }

        .form-group input,
        .form-group select,
        .form-group textarea {
            width: 100%;
            padding: 12px;
            border: 2px solid rgba(192, 192, 192, 0.3);
            border-radius: 10px;
            background: rgba(255, 255, 255, 0.9);
            color: #2d3436;
            font-size: 1rem;
            font-family: 'Georgia', serif;
            transition: border-color 0.3s ease;
        }

        .form-group input:focus,
        .form-group select:focus,
        .form-group textarea:focus {
            border-color: #c0c0c0;
            outline: none;
        }

        .form-group textarea {
            height: 120px;
            resize: vertical;
        }

        .submit-btn {
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            color: #2d3436;
            padding: 15px 40px;
            border: none;
            border-radius: 50px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            font-family: 'Georgia', serif;
        }

        .submit-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(0,0,0,0.3);
            background: linear-gradient(45deg, #a8a8a8, #c0c0c0);
        }

        /* Footer */
        footer {
            background: #2d3436;
            color: white;
            text-align: center;
            padding: 2rem 0;
            border-top: 3px solid #c0c0c0;
        }

        footer p {
            font-family: 'Georgia', serif;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .nav-links {
                display: none;
            }

            .hero h1 {
                font-size: 2.5rem;
            }

            .hero p {
                font-size: 1.1rem;
            }

            .section-title {
                font-size: 2rem;
            }
        }

        /* Animations */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .fade-in {
            animation: fadeInUp 0.8s ease-out;
        }

        /* Floating elements */
        .floating {
            animation: float 6s ease-in-out infinite;
        }

        @keyframes float {
            0%, 100% { transform: translateY(0px); }
            50% { transform: translateY(-20px); }
        }

        /* Elegant touches */
        .elegant-divider {
            width: 100px;
            height: 3px;
            background: linear-gradient(45deg, #c0c0c0, #a8a8a8);
            margin: 2rem auto;
            border-radius: 2px;
        }
    </style>
</head>
<body>
    <header>
        <nav class="container">
            <a href="#" class="logo">Creative Alchemy Ventures 369</a>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#services">Services</a></li>
                <li><a href="#pricing">Pricing</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>

    <section id="home" class="hero">
        <div class="container">
            <div class="hero-content fade-in">
                <h1 class="floating">Transform Your Real Estate Dreams</h1>
                <div class="elegant-divider"></div>
                <p>Exclusive funding solutions for discerning real estate investors and business ventures. Premium service, competitive rates, and personalized attention.</p>
                <a href="#contact" class="cta-button">Get Funded Today</a>
            </div>
        </div>
    </section>

    <section id="services" class="services">
        <div class="container">
            <h2 class="section-title">Our Premium Funding Services</h2>
            <div class="elegant-divider"></div>
            <div class="services-grid">
                <div class="service-card fade-in">
                    <div class="service-icon">🏠</div>
                    <h3>EMD Funding</h3>
                    <p>Earnest Money Deposit funding with competitive rates. Soft EMDs within due diligence periods only. Fast approval and funding process with premium customer service.</p>
                </div>
                <div class="service-card fade-in">
                    <div class="service-icon">🔄</div>
                    <h3>Double Close Funding</h3>
                    <p>24-hour transactional funding for wholesale deals. Seamless double closings with our experienced team and trusted title companies nationwide.</p>
                </div>
                <div class="service-card fade-in">
                    <div class="service-icon">⚡</div>
                    <h3>Morby Method</h3>
                    <p>Specialized funding for the Morby Method strategy. Quick turnaround times and competitive rates for experienced investors seeking premium service.</p>
                </div>
                <div class="service-card fade-in">
                    <div class="service-icon">💼</div>
                    <h3>Business Funding</h3>
                    <p>Comprehensive business funding solutions for entrepreneurs and established businesses looking to expand their operations with sophisticated capital.</p>
                </div>
            </div>
        </div>
    </section>

    <section id="pricing" class="pricing">
        <div class="container">
            <h2 class="section-title">Investment Structure</h2>
            <div class="elegant-divider"></div>
            <div class="pricing-grid">
                <div class="pricing-card">
                    <h3>EMD Funding</h3>
                    <div class="price">$0 - $5k = $1,500</div>
                    <div class="price">$5k - $15k = $3,000</div>
                    <div class="price">$15k - $25k = $6,000</div>
                    <div class="price">$25k - $50k = $15,000</div>
                    <div class="price">$50k - $75k = $25,500</div>
                    <div class="price">$75k - $100k = $37,500</div>
                </div>
                <div class="pricing-card">
                    <h3>Transactional Funding</h3>
                    <div class="price">Up to $500k = 1.125%</div>
                    <div class="price">$500k - $1M = 1.5%</div>
                    <div class="price">$1M - $1.5M = 1.875%</div>
                    <div class="price">Additional days = 0.75%/day</div>
                    <div class="price">Two title companies = 2.25%</div>
                </div>
                <div class="pricing-card">
                    <h3>Required Investment</h3>
                    <div class="price">5% upfront deposit</div>
                    <div class="price">Minimum $375</div>
                    <div class="price">Credits toward total fee</div>
                    <div class="price">Non-refundable</div>
                </div>
            </div>
            <p style="text-align: center; margin-top: 2rem; color: #2d3436; font-style: italic; font-family: 'Georgia', serif;">
                *Premium service fees reflect our commitment to exceptional customer experience and rapid funding execution.
            </p>
        </div>
    </section>

    <section id="contact" class="contact">
        <div class="container">
            <h2 class="section-title">Get Your Deal Funded</h2>
            <div class="elegant-divider"></div>
            <div class="contact-form">
                <form id="fundingForm">
                    <div class="form-group">
                        <label>Your Name *</label>
                        <input type="text" required>
                    </div>
                    <div class="form-group">
                        <label>Email *</label>
                        <input type="email" required>
                    </div>
                    <div class="form-group">
                        <label>Phone *</label>
                        <input type="tel" required>
                    </div>
                    <div class="form-group">
                        <label>Funding Type *</label>
                        <select required>
                            <option value="">Select Funding Type</option>
                            <option value="emd">EMD Funding</option>
                            <option value="double-close">Double Close</option>
                            <option value="morby">Morby Method</option>
                            <option value="business">Business Funding</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Amount Needed *</label>
                        <input type="number" required>
                    </div>
                    <div class="form-group">
                        <label>Property Address</label>
                        <input type="text">
                    </div>
                    <div class="form-group">
                        <label>Deal Details</label>
                        <textarea placeholder="Tell us about your deal, timeline, and exit strategy..."></textarea>
                    </div>
                    <button type="submit" class="submit-btn">Submit Deal for Review</button>
                </form>
            </div>
        </div>
    </section>

    <footer>
        <div class="container">
            <p>&copy; 2025 Creative Alchemy Ventures 369. All rights reserved. | Premium Real Estate & Business Funding Solutions</p>
        </div>
    </footer>

    <script>
        // Smooth scrolling for navigation links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth',
                        block: 'start'
                    });
                }
            });
        });

        // Form submission handler
        document.getElementById('fundingForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            // Collect form data
            const formData = new FormData(this);
            const data = {};
            formData.forEach((value, key) => {
                data[key] = value;
            });
            
            // Simulate form submission
            const submitBtn = this.querySelector('.submit-btn');
            const originalText = submitBtn.textContent;
            
            submitBtn.textContent = 'Submitting...';
            submitBtn.disabled = true;
            
            setTimeout(() => {
                alert('Thank you for your submission! We will review your deal and contact you within 24 hours.');
                this.reset();
                submitBtn.textContent = originalText;
                submitBtn.disabled = false;
            }, 2000);
        });

        // Intersection Observer for animations
        const observerOptions = {
            threshold: 0.1,
            rootMargin: '0px 0px -50px 0px'
        };

        const observer = new IntersectionObserver((entries) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    entry.target.style.animation = 'fadeInUp 0.8s ease-out forwards';
                }
            });
        }, observerOptions);

        // Observe all service cards and pricing cards
        document.querySelectorAll('.service-card, .pricing-card').forEach(card => {
            card.style.opacity = '0';
            observer.observe(card);
        });
    </script>
</body>
</html>
